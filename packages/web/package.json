{
  "name": "@openscout/web",
  "version": "0.2.92",
  "private": true,
  "description": "Baseline Scout web control plane, reusable UI primitives, and bundled local server",
  "homepage": "https://github.com/oscout/scout/tree/main/packages/web#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oscout/scout.git",
    "directory": "packages/web"
  },
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "openscout-web": "./bin/openscout-web.mjs"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "check": "node ./scripts/typecheck.mjs",
    "check:update": "node ./scripts/typecheck.mjs --update",
    "build:client": "vite build",
    "build:native-surfaces": "node ./scripts/build-native-surfaces.mjs",
    "check:native-surfaces": "node ./scripts/validate-native-surfaces.mjs ../../apps/ios/Scout/Resources/WebSurfaces",
    "build:server": "node ./scripts/sync-terminal-relay-session.mjs --check && bun build ./server/index.ts --target=bun --format=esm --outfile ./dist/openscout-web-server.mjs && bun build ./server/pairing-runtime-controller.ts --target=bun --format=esm --outfile ./dist/pairing-runtime-controller.mjs && bun build ./server/knowledge-index-child.ts --target=bun --format=esm --outfile ./dist/knowledge-index-child.mjs && bun build ./server/terminal-relay-node.ts --target=node --format=esm --outfile ./dist/openscout-terminal-relay.mjs --external @lydell/node-pty",
    "dev": "node ./scripts/dev.mjs",
    "dev:m1": "node ./scripts/dev.mjs --edge --local-name m1",
    "dev:m1:http": "node ./scripts/dev.mjs --edge --local-name m1 --http",
    "dev:m1:https": "node ./scripts/dev.mjs --edge --local-name m1 --https",
    "dev:edge": "node ./scripts/dev.mjs --edge",
    "dev:edge:m1": "node ./scripts/dev.mjs --edge --local-name m1",
    "dev:edge:m1:http": "node ./scripts/dev.mjs --edge --local-name m1 --http",
    "dev:edge:m1:https": "node ./scripts/dev.mjs --edge --local-name m1 --https",
    "dev:cleanup:ports": "bash ../../scripts/dev-cleanup.sh --ports-only",
    "relay:check": "node ./scripts/sync-terminal-relay-session.mjs --check",
    "relay:sync": "node ./scripts/sync-terminal-relay-session.mjs",
    "dev:client": "vite --host 127.0.0.1 --port 43122 --strictPort",
    "dev:server": "bun run --hot server/index.ts",
    "prepack": "npm run build && node ../../scripts/prepare-publish-manifest.mjs .",
    "postpack": "node ../../scripts/restore-publish-manifest.mjs .",
    "postpublish": "node ../../scripts/restore-publish-manifest.mjs .",
    "test": "node ./scripts/test.mjs",
    "test:happy": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.107",
    "@arach/arc": "^0.4.1",
    "@base-ui-components/react": "1.0.0-rc.0",
    "@lydell/node-pty": "1.2.0-beta.12",
    "@shikijs/langs": "^4.3.1",
    "@voxd/client": "^0.3.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "^6.0.105",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hudsonkit": "^0.3.5",
    "lucide-react": "^0.577.0",
    "motion": "^12.40.0",
    "picomatch": "^4.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "shiki": "^4.3.1",
    "tailwind-merge": "^3.6.0",
    "uqr": "^0.1.2",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@hono/trpc-server": "^0.4.2",
    "@noble/ciphers": "^2.1.1",
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.0.1",
    "@openscout/agent-sessions": "workspace:*",
    "@openscout/protocol": "workspace:*",
    "@openscout/runtime": "workspace:*",
    "@pierre/diffs": "1.2.7",
    "@tailwindcss/vite": "^4.1.18",
    "@trpc/client": "^11.16.0",
    "@trpc/server": "^11.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react-swc": "^4.3.0",
    "bun-types": "^1.3.11",
    "hono": "^4.12.10",
    "tailwindcss": "^4.1.18",
    "typescript": "^5",
    "vite": "^7.0.0",
    "zod": "^4.3.6"
  }
}
