{
  "$schema": "../spec/adapter-spec.v2.schema.json",
  "specVersion": "2.0.0",
  "adapterId": "devin-acp",
  "displayName": "Devin ACP",
  "implementation": {
    "package": "@openscout/agent-sessions",
    "entrypoint": "src/adapters/devin-acp/adapter.ts",
    "factoryExport": "createAdapter"
  },
  "upstream": {
    "kind": "official_protocol",
    "name": "Devin CLI ACP",
    "transport": "jsonrpc-stdio-jsonl",
    "sources": [
      {
        "kind": "url",
        "ref": "https://docs.devin.ai/cli/reference/commands#devin-acp"
      },
      {
        "kind": "url",
        "ref": "https://agentclientprotocol.com/protocol/v1/schema"
      },
      {
        "kind": "file",
        "ref": "src/adapters/devin-acp/adapter.ts"
      },
      {
        "kind": "file",
        "ref": "src/adapters/acp/adapter.ts"
      }
    ]
  },
  "sessionModel": {
    "lifecycle": "long_lived_process",
    "conversationScope": "session",
    "resumeSupport": "optional",
    "resumeOptionKey": "sessionId",
    "turnSteering": "new_turn_only",
    "concurrentTurns": "single",
    "persistence": [
      "process_state",
      "upstream_session_id",
      "local_files"
    ]
  },
  "capabilities": {
    "promptInputs": {
      "text": true,
      "images": "native",
      "files": "reference_text"
    },
    "outputBlocks": [
      "text",
      "reasoning",
      "action",
      "error"
    ],
    "actionKinds": [
      "tool_call"
    ],
    "streaming": {
      "text": true,
      "reasoning": true,
      "actionOutput": true,
      "actionStatus": true
    },
    "interactive": {
      "questions": "none",
      "approvals": "native",
      "serverRequests": "native"
    },
    "control": {
      "interrupt": true,
      "shutdown": true
    }
  },
  "nativeProtocol": {
    "outboundRequests": [
      "initialize",
      "session/new",
      "session/load",
      "session/prompt"
    ],
    "outboundNotifications": [
      "session/cancel"
    ],
    "inboundNotifications": [
      "session/update"
    ],
    "inboundServerRequests": [
      "session/request_permission",
      "fs/read_text_file",
      "fs/write_text_file"
    ],
    "messageFormats": [
      "jsonrpc_request",
      "jsonrpc_notification",
      "jsonrpc_response",
      "jsonrpc_error",
      "jsonl_transport"
    ],
    "serverRequestStrategy": "resolve_and_reject"
  },
  "normalizedSurface": {
    "adapterMethods": [
      "start",
      "send",
      "interrupt",
      "shutdown"
    ],
    "optionalAdapterMethods": [
      "decide"
    ],
    "emitsPairingEvents": [
      "session:update",
      "turn:start",
      "block:start",
      "block:delta",
      "block:action:output",
      "block:action:status",
      "block:action:approval",
      "block:end",
      "turn:error",
      "turn:end"
    ]
  },
  "conformance": {
    "status": "grandfathered",
    "normalizerId": "acp",
    "fixtureSets": ["acp"]
  },
  "limitations": [
    "This adapter drives the Devin CLI through its `devin acp` stdio mode; it does not call the Devin cloud API directly.",
    "The default launch requires a locally installed devin binary and credentials from `devin auth login` (~/.local/share/devin/credentials.toml) or WINDSURF_API_KEY.",
    "Model selection happens at process launch via `devin acp --model`; Devin does not expose an in-band session/set_model switch.",
    "Devin advertises a `devin-browser` auth method that requires an interactive browser flow, so the adapter does not drive in-band authentication by default.",
    "Devin's ACP surface reports loadSession and session list/delete/additionalDirectories but no session/resume or session/close capability; shutdown relies on process teardown.",
    "Tool calls are normalized as generic tool_call action blocks by the shared ACP adapter."
  ]
}
