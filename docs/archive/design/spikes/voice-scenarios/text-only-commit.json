{
  "name": "text-only-commit",
  "description": "dc turn.commit what's running, no speech audio → reply audio flows",
  "steps": [
    {
      "do": "dc",
      "payload": { "type": "turn.commit", "text": "what's running" }
    },
    { "do": "await", "event": "transcript.user", "timeoutMs": 5000 },
    { "do": "await", "event": "reply.audio.start", "timeoutMs": 8000 },
    { "do": "await", "event": "reply.audio.end", "timeoutMs": 25000 }
  ],
  "expect": {
    "userTranscripts": 1,
    "ladder": "deterministic",
    "maxFirstReplyAudioMs": 2000
  }
}
